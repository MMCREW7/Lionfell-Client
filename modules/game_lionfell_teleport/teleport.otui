// Teleport rock city picker: a small menu next to the rock's bag socket. A transparent layer behind
// it takes clicks elsewhere (they close it) and keeps the rest of the screen from reacting.
LfTeleportCity < UIButton
  ttf-font: Geist-Medium
  ttf-font-size: 13
  color: #e7e5e2
  height: 30
  text-align: left
  padding: 0 12 0 12
  image-source: /images/lionfell/chip
  image-border: 3
  image-color: alpha
  change-cursor-image: true
  cursor: pointer

  $hover:
    image-color: #2a2c2f
    color: #ffffff

  $pressed:
    text-offset: 0 1

UIWidget
  id: teleportLayer
  anchors.fill: parent
  focusable: true
  visible: false
  @onMousePress: modules.game_lionfell_teleport.hide() return true

  LfPanel
    id: teleportMenu
    width: 200
    padding: 8
    @onMousePress: return true
    layout:
      type: verticalBox
      spacing: 2
      fit-children: true

    LfCaps
      id: title
      !text: tr('TELEPORT ROCK')
      height: 22
      text-offset: 4 0

    UIWidget
      id: cities
      phantom: true
      layout:
        type: verticalBox
        spacing: 2
        fit-children: true
