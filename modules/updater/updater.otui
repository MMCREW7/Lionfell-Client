// Lionfell update window: shown at start while the client checks GitHub for a new release
// (updater.lua). Same look as the rest of the client (client_lionfell styles).

LfUpdateBar < LfBar
  height: 6

LfWindow
  id: updaterWindow
  size: 400 214
  anchors.centerIn: parent
  padding: 18 20 18 20

  LfTitle
    id: title
    !text: tr('Lionfell')
    anchors.top: parent.top
    anchors.left: parent.left

  LfMono
    id: caption
    !text: tr('UPDATE')
    anchors.verticalCenter: title.verticalCenter
    anchors.right: parent.right

  LfMuted
    id: status
    !text: tr('Checking for updates...')
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 16
    text-wrap: true
    text-auto-resize: false
    height: 34

  LfUpdateBar
    id: mainProgress
    anchors.top: status.bottom
    anchors.left: parent.left
    anchors.right: percent.left
    margin-top: 8
    margin-right: 10

  LfMono
    id: percent
    !text: '0%'
    width: 38
    text-auto-resize: false
    text-align: right
    anchors.top: status.bottom
    anchors.right: parent.right
    margin-top: 3

  LfMono
    id: downloadStatus
    anchors.top: mainProgress.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 14
    text-auto-resize: false
    height: 14
    visible: false

  LfUpdateBar
    id: downloadProgress
    anchors.top: downloadStatus.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    visible: false

  LfPillButton
    id: skip
    !text: tr('Skip')
    height: 26
    padding: 0 12 0 12
    ttf-font-size: 11
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    @onClick: Updater.abort()
