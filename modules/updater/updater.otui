StaticMainWindow
  id: updaterWindow
  !text: tr('Lionfell update')
  width: 350

  layout:
    type: verticalBox
    fit-children: true

  Label
    id: status
    !text: tr('Checking for updates')
    text-align: center
    text-auto-resize: true
    text-wrap: true

  ProgressBar
    id: mainProgress
    height: 15
    background-color: #c8a24a
    margin-bottom: 5
    margin-top: 5

  Label
    id: downloadStatus
    text-align: center
    text-auto-resize: true
    text-wrap: true
    visible: false

  ProgressBar
    id: downloadProgress
    height: 15
    background-color: #c8a24a
    margin-bottom: 5
    margin-top: 5
    visible: false

  Button
    margin-left: 90
    margin-right: 90
    margin-top: 5
    !text: tr('Skip')
    @onClick: Updater.abort()
