// Quality item tooltip: follows the mouse, sized to its content.
LfItemTipLine < UILabel
  ttf-font: Geist-Regular
  ttf-font-size: 12
  color: #cfccc7
  text-auto-resize: true
  phantom: true
  margin-top: 3

LfItemTip < UIWidget
  image-source: /images/lionfell/panel
  image-border: 6
  image-color: #ffffffee
  padding: 10 12 10 12
  phantom: true
  focusable: false
  layout:
    type: verticalBox
    fit-children: true

  UILabel
    id: name
    ttf-font: Geist-SemiBold
    ttf-font-size: 14
    text-auto-resize: true
    phantom: true

  UILabel
    id: quality
    ttf-font: GeistMono-Medium
    ttf-font-size: 10
    color: #8d8a86
    text-auto-resize: true
    phantom: true
    margin-top: 1

  UILabel
    id: stats
    ttf-font: GeistMono-Regular
    ttf-font-size: 11
    color: #a8a49e
    text-auto-resize: true
    phantom: true
    margin-top: 6

  UIWidget
    id: lines
    phantom: true
    margin-top: 4
    layout:
      type: verticalBox
      fit-children: true

// Detailed item card (hold Alt over a quality item): a centred, Path of Exile style view. The
// border, header band and divider take the quality's colour (items.lua).
LfItemCardText < UILabel
  ttf-font: Geist-Regular
  ttf-font-size: 13
  color: #cfccc7
  text-align: center
  height: 19
  phantom: true

LfItemCardDivider < UIWidget
  height: 1
  margin: 7 18 7 18
  phantom: true

LfItemCard < UIWidget
  background-color: #0b0b0cf2
  border-width: 1
  padding: 0 0 10 0
  phantom: true
  focusable: false
  layout:
    type: verticalBox
    fit-children: true

  UIWidget
    id: header
    height: 50
    border-width: 1
    phantom: true

    UILabel
      id: name
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 7
      height: 20
      ttf-font: Geist-SemiBold
      ttf-font-size: 15
      text-align: center
      phantom: true

    UILabel
      id: base
      anchors.top: name.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 1
      height: 18
      ttf-font: Geist-Medium
      ttf-font-size: 13
      text-align: center
      phantom: true

  UIWidget
    id: body
    margin-top: 8
    phantom: true
    layout:
      type: verticalBox
      fit-children: true
