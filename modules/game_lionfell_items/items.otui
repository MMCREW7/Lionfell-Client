// Quality item tooltip: follows the mouse, sized to its content.
LfItemTipLine < UILabel
  ttf-font: Geist-Regular
  ttf-font-size: 12
  color: #cfccc7
  text-auto-resize: true
  phantom: true
  margin-top: 3

LfItemTip < UIWidget
  image-source: /images/lionfell/panel
  image-border: 6
  image-color: #ffffffee
  padding: 10 12 10 12
  phantom: true
  focusable: false
  layout:
    type: verticalBox
    fit-children: true

  UILabel
    id: name
    ttf-font: Geist-SemiBold
    ttf-font-size: 14
    text-auto-resize: true
    phantom: true

  UILabel
    id: quality
    ttf-font: GeistMono-Medium
    ttf-font-size: 10
    color: #8d8a86
    text-auto-resize: true
    phantom: true
    margin-top: 1

  UILabel
    id: stats
    ttf-font: GeistMono-Regular
    ttf-font-size: 11
    color: #a8a49e
    text-auto-resize: true
    phantom: true
    margin-top: 6

  UIWidget
    id: lines
    phantom: true
    margin-top: 4
    layout:
      type: verticalBox
      fit-children: true
