// Lionfell phone HUD. Loaded into the game root panel; positioned for a landscape phone
// (~1333x600 UI pixels at the default size, client_lionfell_mobile).

LfRoundButton < UIButton
  size: 48 48
  image-source: /images/lionfell/slot
  image-border: 4
  image-color: #ffffffdd
  font: verdana-11px-monochrome
  color: #e7e5e2
  text-align: center
  $pressed:
    image-color: #c9a56b

LfModeButton < LfRoundButton
  size: 52 34
  font: verdana-11px-monochrome
  $checked:
    image-color: #c9a56b
    color: #0b0b0c

LfSkillSlot < UIButton
  size: 56 56
  image-source: /images/lionfell/slot
  image-border: 4
  $pressed:
    image-color: #c9a56b

  UIItem
    id: item
    anchors.centerIn: parent
    size: 40 40
    phantom: true
    virtual: true

  UIWidget
    id: icon
    anchors.centerIn: parent
    size: 40 40
    phantom: true

  UIWidget
    id: shade
    anchors.fill: parent
    background-color: #000000aa
    phantom: true
    visible: false

LfMenuTile < UIButton
  size: 132 84
  image-source: /images/lionfell/panel
  image-border: 6
  $pressed:
    image-color: #c9a56b

  LfTitle
    id: key
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 14
    margin-left: 14
    phantom: true

  LfMuted
    id: label
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 12
    margin-left: 14
    phantom: true

LfAssignTile < UIButton
  size: 228 56
  image-source: /images/lionfell/panel
  image-border: 6
  $pressed:
    image-color: #c9a56b
  $checked:
    image-color: #c9a56b
  $disabled:
    opacity: 0.4

  UIWidget
    id: icon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 12
    size: 32 32
    phantom: true

  UIItem
    id: item
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 12
    size: 32 32
    phantom: true
    virtual: true

  LfLabel
    id: name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 54
    margin-top: 11
    phantom: true

  LfMuted
    id: sub
    anchors.left: name.left
    anchors.right: parent.right
    anchors.top: name.bottom
    margin-top: 3
    phantom: true

UIWidget
  id: lionfellMobileHud
  anchors.fill: parent
  phantom: true
  focusable: false

  // status: name, level, health and mana
  LfPanel
    id: status
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 10
    margin-left: 10
    size: 250 74
    padding: 10 12 10 12
    phantom: true

    LfTitle
      id: name
      anchors.top: parent.top
      anchors.left: parent.left
      phantom: true

    LfMono
      id: level
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 2
      phantom: true

    LfBar
      id: hp
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: name.bottom
      margin-top: 8
      height: 10

    LfBar
      id: mp
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: hp.bottom
      margin-top: 6
      height: 8

  // the menu: three bars, opens the sheet
  LfRoundButton
    id: menuButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 10
    margin-right: 10

    UIWidget
      size: 22 3
      anchors.centerIn: parent
      margin-top: -8
      background-color: #e7e5e2
      phantom: true
    UIWidget
      size: 22 3
      anchors.centerIn: parent
      background-color: #e7e5e2
      phantom: true
    UIWidget
      size: 22 3
      anchors.centerIn: parent
      margin-top: 8
      background-color: #e7e5e2
      phantom: true

  // bottom right: attack, skills (action bar 1, slots 1-6) and tap modes
  UIWidget
    id: actions
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 12
    margin-bottom: 12
    size: 300 260
    phantom: true

    UIButton
      id: attack
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      size: 92 92
      image-source: /images/lionfell/button_primary
      image-border: 6
      font: verdana-11px-monochrome
      color: #0b0b0c
      text: ATTACK

  UIWidget
    id: modes
    anchors.right: parent.right
    anchors.top: menuButton.bottom
    margin-right: 10
    margin-top: 10
    width: 52
    height: 160
    phantom: true
    layout:
      type: verticalBox
      spacing: 6

  // the sheet: every window as a large tile
  UIWidget
    id: sheet
    anchors.fill: parent
    background-color: #0b0b0ce6
    visible: false
    focusable: true

    LfCaps
      id: sheetTitle
      anchors.top: parent.top
      anchors.left: tiles.left
      margin-top: 24
      text: MENU

    LfRoundButton
      id: sheetClose
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 10
      margin-right: 10
      text: X

    UIWidget
      id: tiles
      anchors.centerIn: parent
      size: 708 284
      layout:
        type: grid
        cell-size: 132 84
        cell-spacing: 12
        num-columns: 5
        flow: true

  // long press on a skill button: what it does (saved in action bar 1, as on PC)
  UIWidget
    id: assign
    anchors.fill: parent
    background-color: #0b0b0cf0
    visible: false
    focusable: true

    LfTitle
      id: assignTitle
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 18
      margin-left: 24

    LfPillButton
      id: tabSpells
      anchors.top: assignTitle.bottom
      anchors.left: parent.left
      margin-top: 12
      margin-left: 24
      size: 110 36
      text: Spells

    LfPillButton
      id: tabItems
      anchors.top: tabSpells.top
      anchors.left: tabSpells.right
      margin-left: 8
      size: 110 36
      text: Items

    LfButton
      id: assignClear
      anchors.top: tabSpells.top
      anchors.left: tabItems.right
      margin-left: 24
      size: 110 36
      text: Clear

    LfRoundButton
      id: assignClose
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 10
      margin-right: 10
      text: X

    ScrollablePanel
      id: assignList
      anchors.top: tabSpells.bottom
      anchors.left: parent.left
      anchors.right: assignScroll.left
      anchors.bottom: assignModes.top
      margin-top: 14
      margin-left: 24
      margin-right: 8
      margin-bottom: 10
      vertical-scrollbar: assignScroll
      layout:
        type: grid
        cell-size: 228 56
        cell-spacing: 10
        flow: true

    VerticalScrollBar
      id: assignScroll
      anchors.top: tabSpells.bottom
      anchors.bottom: assignModes.top
      anchors.right: parent.right
      margin-top: 14
      margin-bottom: 10
      margin-right: 24
      step: 66
      pixels-scroll: true

    UIWidget
      id: assignModes
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 24
      margin-bottom: 16
      height: 44
      visible: false
      layout:
        type: horizontalBox
        spacing: 10
